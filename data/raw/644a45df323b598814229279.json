        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "Eligibility "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant must be a farmer residing in Gujarat state."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must have availed of a loan for agricultural purposes from a cooperative institution or a bank."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must have suffered crop loss due to natural calamities such as drought, flood, or earthquake."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must possess the land for agricultural purposes in his/her name or have the right to cultivate such land."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The land should be surveyed by the Revenue Department of Gujarat and should have a record of rights."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The crop loss should be certified by the Revenue Department of Gujarat."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant should have insured the crop under the Pradhan Mantri Fasal Bima Yojana or any other crop insurance scheme recognized by the Government of Gujarat."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "**Eligibility** \n\n1. The applicant must be a farmer residing in Gujarat state.\n1. The applicant must have availed of a loan for agricultural purposes from a cooperative institution or a bank.\n1. The applicant must have suffered crop loss due to natural calamities such as drought, flood, or earthquake.\n1. The applicant must possess the land for agricultural purposes in his/her name or have the right to cultivate such land.\n1. The land should be surveyed by the Revenue Department of Gujarat and should have a record of rights.\n1. The crop loss should be certified by the Revenue Department of Gujarat.\n1. The applicant should have insured the crop under the Pradhan Mantri Fasal Bima Yojana or any other crop insurance scheme recognized by the Government of Gujarat.\n\n"
        },
        "schemeContent": {
