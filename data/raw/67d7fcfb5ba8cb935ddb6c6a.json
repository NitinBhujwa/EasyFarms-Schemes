        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "bold": true,
                  "text": ""
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant must be a farmer."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant should own a land. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must belong to the Gujarat state."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "Note: "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Under this scheme, even if the tenant farmer has more than one account, the assistance will be availed only once."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "In case of joint account, the farmers will be entitled to benefit from only one of the tenants mentioned in 8-A of their land."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "eligibilityDescription_md": "<br>\n\n\n- The applicant must be a farmer.\n- The applicant should own a land. \n- The applicant must belong to the Gujarat state.\n\n**Note:** \n\n  - Under this scheme, even if the tenant farmer has more than one account, the assistance will be availed only once.\n  - In case of joint account, the farmers will be entitled to benefit from only one of the tenants mentioned in 8-A of their land.\n\n"
        },
