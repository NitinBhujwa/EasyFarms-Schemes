        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant must be a permanent resident of Haryana and possess a valid Parivar Pehchan Patra (PPP)."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must have access to own land or hold a registered lease for a minimum period of 10 years."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must ensure that the land is free from any legal and financial encumbrances."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must have access to a reliable water source such as a canal, tube well, river, or similar."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must provide a valid training certificate in fisheries or aquaculture."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must agree to manage and maintain the system at their own cost after setup."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must submit a Detailed Project Report (DPR) or a Self-Contained Proposal (SCP)."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must sign an agreement with the Department of Fisheries to avail benefits under the scheme."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "\n1. The applicant must be a permanent resident of Haryana and possess a valid Parivar Pehchan Patra (PPP).\n1. The applicant must have access to own land or hold a registered lease for a minimum period of 10 years.\n1. The applicant must ensure that the land is free from any legal and financial encumbrances.\n1. The applicant must have access to a reliable water source such as a canal, tube well, river, or similar.\n1. The applicant must provide a valid training certificate in fisheries or aquaculture.\n1. The applicant must agree to manage and maintain the system at their own cost after setup.\n1. The applicant must submit a Detailed Project Report (DPR) or a Self-Contained Proposal (SCP).\n1. The applicant must sign an agreement with the Department of Fisheries to avail benefits under the scheme.\n\n"
        },
