      "en": {
        "applicationProcess": [
          {
            "mode": "Online",
            "process": [
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Application Process"
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Visit the "
                      },
                      {
                        "children": [
                          {
                            "text": "official website"
                          }
                        ],
                        "link": "https://agri.gujarat.gov.in/",
                        "type": "link"
                      },
                      {
                        "text": " of the Gujarat government's agriculture department."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Navigate to the Mukhya Mantri Kisan Sahay Yojana page."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Download the application form for the scheme."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Fill in the application form with accurate details."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Attach the required documents such as proof of land ownership, crop loss certificate, and bank loan documents."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Submit the application form along with the supporting documents to the nearest agricultural office or bank branch."
                      }
                    ],
                    "type": "list_item"
                  }
                ],
                "type": "ol_list"
              }
            ],
            "url": "https://agri.gujarat.gov.in/"
          },
          {
            "mode": "Offline",
            "process": [
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Application Process"
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Farmers need to visit their nearest E Gram Centre to apply for financial assistance under Mukhyamantri Kisan Sahay Yojana in case of crop loss due to natural calamity."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "The assistant present at the centre will fill out the application form for farmers free of cost."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Aadhar Card and Proof of Land Records are mandatorily needed to fill out the application form."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Once the Application Form is finally submitted, the assistant will provide a printout of the application form to the farmer."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "The application Form along with all the documents will be forwarded to District Agriculture Officer for verification."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "District Agriculture Officer will do physical verification of the agricultural field and access the crop loss of the farmer."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "Then DAO submits its report to the Department of Agriculture for final approval."
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "children": [
                      {
                        "text": "After final approval from the department, the amount of financial assistance will be transferred to the given bank account of the farmer."
                      }
                    ],
                    "type": "list_item"
                  }
                ],
                "type": "ol_list"
              }
            ],
            "url": ""
          }
        ],
