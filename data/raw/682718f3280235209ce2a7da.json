        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The following beneficiaries are eligible under this scheme:"
                    }
                  ],
                  "type": "paragraph"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Arunachal State Rural Livelihoods Mission (ArSRLM) promoted Self-Help Groups (SHGs), individuals, Farmers' Clubs, Registered Cooperative Societies, and Dairy Cooperative Societies (DCS) will be eligible."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "Individuals should belong to the Arunachal Pradesh Scheduled Tribe (APST) category and be unemployed."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "eligibilityDescription_md": "The following beneficiaries are eligible under this scheme:\n\n  - Arunachal State Rural Livelihoods Mission (ArSRLM) promoted Self-Help Groups (SHGs), individuals, Farmers&amp;#39; Clubs, Registered Cooperative Societies, and Dairy Cooperative Societies (DCS) will be eligible.\n  - Individuals should belong to the Arunachal Pradesh Scheduled Tribe (APST) category and be unemployed.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Under this scheme, financial assistance in the form of credit-linked support is provided to eligible beneficiaries for livestock rearing and allied activities."
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "align_justify"
            }
          ],
          "benefits_md": "Under this scheme, financial assistance in the form of credit-linked support is provided to eligible beneficiaries for livestock rearing and allied activities.\n",
          "briefDescription": "The scheme aims to enhance rural livelihoods, promote sustainable animal husbandry practices, & contribute to self-reliance in livestock sector. Under this scheme, financial assistance is provided to unemployed individuals, SHGs, cooperative societies, etc. for livestock rearing & allied activities.",
          "detailedDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The scheme \"Atma Nirbhar Pashu Palan Yojna (ANPPY)\", implemented by the Department of Animal Husbandry, Veterinary & Dairy Development, Government of Arunachal Pradesh, aims to enhance rural livelihoods, promote sustainable animal husbandry practices, and contribute to self-reliance in the livestock sector. Under this scheme, financial assistance in the form of credit-linked support is provided to unemployed individuals, Self-Help Groups (SHGs), farmers' clubs, cooperative societies, and Dairy Cooperative Societies (DCS) for livestock rearing and allied activities."
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "align_justify"
            }
          ],
          "detailedDescription_md": "The scheme &amp;quot;Atma Nirbhar Pashu Palan Yojna (ANPPY)&amp;quot;, implemented by the Department of Animal Husbandry, Veterinary &amp;amp; Dairy Development, Government of Arunachal Pradesh, aims to enhance rural livelihoods, promote sustainable animal husbandry practices, and contribute to self-reliance in the livestock sector. Under this scheme, financial assistance in the form of credit-linked support is provided to unemployed individuals, Self-Help Groups (SHGs), farmers&amp;#39; clubs, cooperative societies, and Dairy Cooperative Societies (DCS) for livestock rearing and allied activities.\n",
