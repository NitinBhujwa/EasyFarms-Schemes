        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Up to 50% of the purchased price per hectare or ₹750/- (within a maximum limit of 4 hectares per account."
