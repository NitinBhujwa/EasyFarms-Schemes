        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "Financial Assistance: "
                        },
                        {
                          "text": "Under the scheme, financial assistance ranging from ₹1,400/- to ₹7,000/- is provided per beneficiary."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "Free Distribution of Inputs:"
                        },
                        {
                          "text": " Beneficiaries are provided seeds, seed treatment chemicals, organic and chemical fertilizers, and insecticidal medicines free of cost."
                        }
                      ],
                      "type": "list_item"
