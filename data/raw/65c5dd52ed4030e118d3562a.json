          "eligibilityDescription_md": "\n   1. The applicant/farmer should be a permanent resident of Meghalaya.\n   1. The applicant should be a bonafide farmer engaged in agriculture.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 3,
            "label": "Composite",
            "value": "composite"
          },
          "benefits": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "Pattern of Assistance:",
                  "underline": true
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "By providing good quality flower planting material at 50% subsidy and low cost polyhouse free of cost with a minimum of 100sqm/unit area."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                },
                {
                  "children": [
                    {
                      "bold": true,
                      "text": "Type of Assistance:"
                    }
                  ],
                  "type": "block_quote"
                }
              ],
              "type": "align_justify"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "To motivate farmers by cultivating low volume high-value crops to increase economic income. Under this aspect, poly house and good quality flower planting materials including organic fertilizers, micronutrients, and organic-based and P.P chemicals and drip irrigation are provided."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "benefits_md": "> **Pattern of Assistance:**\n\n\n  - By providing good quality flower planting material at 50% subsidy and low cost polyhouse free of cost with a minimum of 100sqm/unit area.\n\n&gt; **Type of Assistance:**\n\n\n  - To motivate farmers by cultivating low volume high-value crops to increase economic income. Under this aspect, poly house and good quality flower planting materials including organic fertilizers, micronutrients, and organic-based and P.P chemicals and drip irrigation are provided.\n\n",
          "briefDescription": "The objective of the scheme is to motivate the farmers to take up floriculture (traditional and non-traditional flowers) as a commercial venture through the distribution of planting materials and other inputs.",
          "detailedDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The scheme “Floriculture Development Scheme” was launched by the Department of Agriculture & Farmers’ Welfare, Government of Meghalaya to motivate the farmers to take up floriculture (traditional and non-traditional flowers) as a commercial venture through the distribution of planting materials and other inputs."
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "align_justify"
            }
          ],
          "detailedDescription_md": "The scheme “Floriculture Development Scheme” was launched by the Department of Agriculture &amp;amp; Farmers’ Welfare, Government of Meghalaya to motivate the farmers to take up floriculture (traditional and non-traditional flowers) as a commercial venture through the distribution of planting materials and other inputs.\n",
