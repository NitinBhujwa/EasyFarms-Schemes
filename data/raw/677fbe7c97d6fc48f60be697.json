            "process": [
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Application Process for Loanee Farmers",
                    "underline": true
                  }
                ],
                "type": "block_quote"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step-1"
                  },
                  {
                    "text": ": Loanee farmers need to visit their nearest bank or primary agricultural cooperative society (PACS) branch, where they have taken the loan."
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step-2: "
                  },
                  {
                    "text": "The bank will automatically enroll the farmer in the NAIS."
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step-3:"
                  },
                  {
                    "text": " Premiums are deducted directly from the loan amount at the time of disbursement"
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Application Process for Non-Loanee Farmers",
