                      {
                        "text": "Bank account details for claim disbursement."
                      }
                    ],
                    "type": "list_item"
                  }
                ],
                "type": "ul_list"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step-4: Pay the Premium"
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Pay the premium amount at the time of application. The premium amount is based on the type of crop and the coverage opted for."
