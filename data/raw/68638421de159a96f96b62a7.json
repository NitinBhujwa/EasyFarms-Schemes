        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant must have a Parivar Pehchan Patra (PPP)."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must submit an undertaking in the Detailed Project Report (DPR)/Self-Contained Proposal (SCP) stating that all operational, maintenance, and post-construction management costs of the infrastructure facilities will be borne by them."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must commit to keeping the fish market in operational condition for 10 years."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must agree to permanently display a board at the infrastructure facility indicating that the fish market was constructed with Central Assistance under the Pradhan Mantri Matsya Sampada Yojana (PMMSY)."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Central assistance will be restricted to one unit per individual beneficiary."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Projects with land on a long-term registered lease will also be considered for Central financial assistance. The registered lease period or agreement must not be less than a minimum period of 10 years."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "\n1. The applicant must have a Parivar Pehchan Patra (PPP).\n1. The applicant must submit an undertaking in the Detailed Project Report (DPR)/Self-Contained Proposal (SCP) stating that all operational, maintenance, and post-construction management costs of the infrastructure facilities will be borne by them.\n1. The applicant must commit to keeping the fish market in operational condition for 10 years.\n1. The applicant must agree to permanently display a board at the infrastructure facility indicating that the fish market was constructed with Central Assistance under the Pradhan Mantri Matsya Sampada Yojana (PMMSY).\n1. Central assistance will be restricted to one unit per individual beneficiary.\n1. Projects with land on a long-term registered lease will also be considered for Central financial assistance. The registered lease period or agreement must not be less than a minimum period of 10 years.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "text": "The scheme provides a subsidy for the construction of fish retail markets, including ornamental fish or aquarium markets. The project cost is ₹1,00,00,000/- per unit."
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "The subsidy provided is:"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "40% of the project cost is for beneficiaries belonging to the General Category."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "60% of the project cost is for beneficiaries belonging to the Scheduled Caste (SC) or Women categories."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
