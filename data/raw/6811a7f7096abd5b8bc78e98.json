          "eligibilityDescription_md": "\n   1. The applicant must be a farmer.\n   1. The applicant must be a resident of Gujarat.\n   1. The applicant must have suffered crop loss due to natural calamity.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "As per the assistance norms fixed by the State Government, keeping in view the natural calamities that occur from time to time"
