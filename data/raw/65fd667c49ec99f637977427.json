        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant should be a farmer."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The applicant should be a native of Rajasthan."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The applicant must have agricultural land ownership and irrigation sources."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "Farmers with land between 0.4 and 4 hectares are eligible for the grant."
