  "content_hash": "097d94d5e516af83978d260810237cdd1debfec7cc217e2c7335fb1a1bc1eab0",
  "dbt_scheme": false,
  "deactivated_at": "2026-08-29T16:09:03.365268+00:00",
  "detailed_description": "“Cluster Mei Bagwani Ki Yojana-II” launched by the Department of Agriculture, Bihar, aims to promote cluster-based cultivation of selected crops, including guava, amla, lemon, bael, lemongrass, papaya, marigold, dragon fruit, and strawberry. The scheme offers subsidies to farmers to expand crop areas and enhance agricultural income.\n",
  "eligibility": "\n   1. The applicant should be an individual farmers/ farmers group/ Farmers Producer Organization (FPO)/ cooperative society or registered institution.\n   1. The applicant must have agricultural land a minimum of 0.25 acres and a maximum of 10 acres (25 acres for cluster area).\n   1. The applicant must be registered on the DBT portal.\n\n",
  "exclusions": "<br>\n\n",
