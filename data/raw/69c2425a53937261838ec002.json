          ],
          "benefits_md": "> **The awardees are presented with certificate and a plaque.**\n\n<br>\n\n",
          "briefDescription": "The objective of the scheme is to honour individuals and teams for extraordinary achievements and outstanding contributions in the field of mineral discovery & exploration, fundamental / applied geosciences, mining and allied areas. ",
          "detailedDescription": [
            {
              "children": [
                {
                  "text": "The National Mineral Awards Scheme was instituted in the year 1966 by the Ministry of Mines, Government of India. The scope of the awards has been expanded and the name changed to National Geoscience Awards (NGA) from 2009."
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "The objective of the scheme is to honour individuals and teams for extraordinary achievements and outstanding contributions in the field of mineral discovery & exploration, fundamental / applied geosciences, mining and allied areas. "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "Broad Disciplines:-",
                  "underline": true
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "1) Mineal Discovery & Exploration "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "2) Mining Technology, Mineral Beneficiation & Sustainable Mineral Development "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "3) Basic Geosciences"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "4) Applied Geosciences"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "No. of Awardees",
                  "underline": true
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "1) National Geoscience Award for Lifetime Achievement - 1 "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "2) National Geoscience Award - 10 (Individual/ Team) "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "3) National Young Geoscientist Award - 1"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "There are three categories of awards under the National Geoscience Awards:",
                  "underline": true
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "(i) National Geoscience Award for Lifetime Achievement"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "(ii) National Geoscience Award and"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": "(iii) National Young Geoscientist Award"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "text": ""
