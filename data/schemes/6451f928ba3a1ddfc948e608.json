        },
        {
          "children": [
            {
              "bold": true,
              "text": "Step 3: "
            },
            {
              "text": "Submit the duly filled and signed application form along with the documents to the Assistant Commissioner, District Social Welfare Office."
            }
          ],
          "type": "paragraph"
        },
        {
          "children": [
            {
              "bold": true,
              "text": "Step 4: "
            },
            {
              "text": "Acquire the receipt/acknowledgment of the successful submission of the application form from the District Social Welfare Office."
            }
