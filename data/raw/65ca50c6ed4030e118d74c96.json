                    "children": [
                      {
                        "bold": true,
                        "text": "Step 03:"
                      },
                      {
                        "text": " Submit the duly filled and signed application along with the required documents at the nearest office of the Horticulture Development Officer of a Community Development Block/Horticulture Circle/District Horticulture Officer."
                      }
