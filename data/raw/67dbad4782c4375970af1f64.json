        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "Assistance for Coconut Cultivation:"
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Financial support of ₹37,500/- per hectare, covering 75% of the total cost (₹50,000/- per hectare)."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "Promotion of Integrated Pest Management (IPM) and Integrated Nutrient Management (INM):"
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Financial support of ₹5,000/- per hectare, covering 50% of the total cost (₹10,000/- per hectare)."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            }
          ],
          "benefits_md": "> **Assistance for Coconut Cultivation:**\n\n\n- Financial support of ₹37,500/- per hectare, covering 75% of the total cost (₹50,000/- per hectare).\n\n> **Promotion of Integrated Pest Management (IPM) and Integrated Nutrient Management (INM):**\n\n\n- Financial support of ₹5,000/- per hectare, covering 50% of the total cost (₹10,000/- per hectare).\n\n",
          "briefDescription": "The \"Coconut Development Scheme\" introduced by the Agriculture, Farmers Welfare and Cooperation Department, Gujarat, aims to support farmers by providing quality coconut saplings and financial assistance for coconut cultivation. ",
          "detailedDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The \"Coconut Development Scheme\" introduced by the Agriculture, Farmers Welfare and Cooperation Department, Gujarat, aims to encourage farmers by providing quality coconut saplings at reasonable prices and financial assistance for coconut cultivation. It also promotes sustainable agricultural practices through Integrated Pest Management (IPM) and Integrated Nutrient Management (INM)."
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "align_justify"
            }
          ],
          "detailedDescription_md": "The &amp;quot;Coconut Development Scheme&amp;quot; introduced by the Agriculture, Farmers Welfare and Cooperation Department, Gujarat, aims to encourage farmers by providing quality coconut saplings at reasonable prices and financial assistance for coconut cultivation. It also promotes sustainable agricultural practices through Integrated Pest Management (IPM) and Integrated Nutrient Management (INM).\n",
