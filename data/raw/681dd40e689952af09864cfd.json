          "eligibilityDescription_md": "\n  - The applicant must be a farmer.\n  - The applicant must be a resident of Gujarat.\n  - The applicant must be engaged in agricultural activities.\n  - The applicant must be willing to adopt LFOM/FOM on their farm.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "An amount of ₹4,000/- per acre for using LFOM or FOM."
