        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant should be an individual farmer, cooperative society, self-help group, or joint liability group. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The cooperative society, self-help group, or joint liability group having a minimum of 10 members. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must possess a Family Identity Card (Parivar Pehchan Patra)."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must obtain prior permission from the Government of Haryana and competent authorities."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The cage location must have year-round water availability and a minimum of 8 meters depth."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant should take government permission for rearing exotic fish species. "
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "\n1. The applicant should be an individual farmer, cooperative society, self-help group, or joint liability group. \n1. The cooperative society, self-help group, or joint liability group having a minimum of 10 members. \n1. The applicant must possess a Family Identity Card (Parivar Pehchan Patra).\n1. The applicant must obtain prior permission from the Government of Haryana and competent authorities.\n1. The cage location must have year-round water availability and a minimum of 8 meters depth.\n1. The applicant should take government permission for rearing exotic fish species. \n\n"
