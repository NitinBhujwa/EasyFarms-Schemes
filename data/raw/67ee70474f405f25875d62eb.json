      "en": {
        "applicationProcess": [
          {
            "mode": "Online",
            "process": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 1:"
                      },
                      {
                        "text": " The applicant may visit and apply online at I-Khedut Portal: "
                      },
                      {
                        "children": [
                          {
                            "text": "https://ikhedut.gujarat.gov.in/"
                          }
                        ],
                        "link": "https://ikhedut.gujarat.gov.in/",
                        "type": "link"
                      },
                      {
                        "text": ""
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 2:"
                      },
                      {
                        "text": " On the home page, click on ‘Schemes’ and then click on ‘Animal Husbandry Schemes’."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 3:"
                      },
                      {
                        "text": " Now select the scheme, click on the ‘Apply’ button and an application page will open."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 4:"
                      },
                      {
                        "text": " Click on \"Apply New\" button and submit a new application."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 5:"
                      },
                      {
                        "text": " Click on the \"Update Application\" button to add corrections to the application."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 6: "
                      },
                      {
                        "text": "Once the application is done, confirm it."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 7:"
                      },
                      {
                        "text": " Take a print out of the confirmed application and submit Related Documents through to concern Taluka office."
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Step 8:"
                      },
                      {
                        "text": " Applicant can also check their Application Status/View/Print/Upload Application details from the below link: "
                      },
                      {
                        "children": [
                          {
                            "text": "https://ikhedut.gujarat.gov.in/public/frm_Applicant_Corner.aspx"
                          }
                        ],
                        "link": "https://ikhedut.gujarat.gov.in/public/frm_Applicant_Corner.aspx",
                        "type": "link"
                      },
                      {
                        "text": " "
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "children": [
                      {
                        "bold": true,
                        "text": "Contact Us:"
                      },
                      {
                        "text": " "
                      },
                      {
                        "children": [
                          {
                            "text": "Click here"
                          }
                        ],
                        "link": "https://ikhedut.gujarat.gov.in/Public/frm_Public_Contacts.aspx",
                        "type": "link"
                      },
                      {
                        "text": "."
                      }
                    ],
                    "type": "block_quote"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "bold": true,
                            "text": "Note:"
                          },
                          {
                            "text": " Before application, beneficiaries must complete poultry training at the Intensive Poultry Development Project or District Poultry Extension Centre."
                          }
                        ],
                        "type": "block_quote"
                      }
                    ],
                    "type": "align_justify"
                  }
                ],
                "type": "align_justify"
              }
            ],
            "process_md": "**Step 1:** The applicant may visit and apply online at I-Khedut Portal: [https://ikhedut.gujarat.gov.in/](https://ikhedut.gujarat.gov.in/)\n**Step 2:** On the home page, click on ‘Schemes’ and then click on ‘Animal Husbandry Schemes’.\n**Step 3:** Now select the scheme, click on the ‘Apply’ button and an application page will open.\n**Step 4:** Click on &amp;quot;Apply New&amp;quot; button and submit a new application.\n**Step 5:** Click on the &amp;quot;Update Application&amp;quot; button to add corrections to the application.\n**Step 6:** Once the application is done, confirm it.\n**Step 7:** Take a print out of the confirmed application and submit Related Documents through to concern Taluka office.\n**Step 8:** Applicant can also check their Application Status/View/Print/Upload Application details from the below link: [https://ikhedut.gujarat.gov.in/public/frm_Applicant_Corner.aspx](https://ikhedut.gujarat.gov.in/public/frm_Applicant_Corner.aspx) \n&gt; **Contact Us:** [Click here](https://ikhedut.gujarat.gov.in/Public/frm_Public_Contacts.aspx).\n\n&amp;gt; **Note:** Before application, beneficiaries must complete poultry training at the Intensive Poultry Development Project or District Poultry Extension Centre.\n\n"
          }
        ],
