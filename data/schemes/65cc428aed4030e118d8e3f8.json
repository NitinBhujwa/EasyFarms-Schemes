  "benefit_type": {
    "id": 3,
    "label": "Composite",
    "value": "composite"
  },
  "benefits": "\n1. Farmer training within the state : ₹1,000/- per farmer per month (maximum 7 days)\n1. Farmer training outside the state : ₹1,500/- per farmer per day.\n1. Exposure visit outside the state to observe new technology (new component) : ₹1,500/- per farmer per day.\n1. A total of ₹12,000/- for 20 trainees in one-day farmer training and tour, i.e. maximum expenditure per farmer is ₹500/- and honorarium to the host farmer is ₹100/-, thus the total maximum expenditure is Rs 600/- per farmer.\n\n",
  "brief_description": null,
