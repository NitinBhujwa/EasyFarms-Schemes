              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step 1:"
                  },
                  {
                    "text": " Visit the official "
                  },
                  {
                    "children": [
                      {
                        "text": "website"
                      }
                    ],
                    "link": "https://horticulture.bihar.gov.in/HORTMIS/InputBasedStateScheme/OnlineAppMushroomKitState.aspx",
                    "type": "link"
                  },
                  {
                    "text": ". "
