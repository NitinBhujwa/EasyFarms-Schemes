  "deactivated_at": "2026-08-30T16:13:36.686590+00:00",
  "detailed_description": "The scheme “Top Working Program” launched by the Horticulture and Food Processing Department, Madhya Pradesh, aims to enhance horticultural productivity by training rural unemployed youth to convert local fruit plant species into improved varieties and providing financial assistance for grafting activities.\n<br>\n\n",
  "eligibility": "\n  - The applicant must be a resident of Madhya Pradesh.\n  - The applicant must belong to rural area.\n  - The applicant must be an unemployed youth.\n\n<br>\n\n",
  "exclusions": null,
