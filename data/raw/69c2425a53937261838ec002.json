        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant should be an Indian citizen and a professionally qualified geoscientist, engineer, technologist, or academician with significant contributions in relevant fields."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant’s work should primarily be carried out in India within the last ten years, except for the Lifetime Achievement Award."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "A team nomination can include a maximum of four members, with limited team awards available."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant for the Young Geoscientist Award should be below 35 years of age as of 31st December of the preceding year."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant can receive an award only once in a particular field but may apply in other fields."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Recipients of the Lifetime Achievement Award are not eligible to apply for any other awards."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "A certificate from the head of institution or department confirming the nominee’s work is desirable but not mandatory."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "type": "paragraph"
            }
          ],
          "eligibilityDescription_md": "\n1. The applicant should be an Indian citizen and a professionally qualified geoscientist, engineer, technologist, or academician with significant contributions in relevant fields.\n1. The applicant’s work should primarily be carried out in India within the last ten years, except for the Lifetime Achievement Award.\n1. A team nomination can include a maximum of four members, with limited team awards available.\n1. The applicant for the Young Geoscientist Award should be below 35 years of age as of 31st December of the preceding year.\n1. The applicant can receive an award only once in a particular field but may apply in other fields.\n1. Recipients of the Lifetime Achievement Award are not eligible to apply for any other awards.\n1. A certificate from the head of institution or department confirming the nominee’s work is desirable but not mandatory.\n\n<br>\n\n"
        },
        "schemeContent": {
