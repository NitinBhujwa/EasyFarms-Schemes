          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "For General Category Farmers: "
                        },
                        {
                          "text": "Financial assistance of ₹1,500/- per hectare, including ₹1,400/- for hybrid/improved seeds and ₹100/- for seed treatment medicine."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "For Scheduled Caste/Scheduled Tribe Farmers: "
                        },
                        {
                          "text": "Financial assistance of ₹2,250/- per hectare, including ₹2,100/- for hybrid/improved seeds and ₹150/- for seed treatment medicine."
