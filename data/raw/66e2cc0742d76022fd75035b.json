                      "children": [
                        {
                          "bold": true,
                          "text": "Financial Assistance:"
                        },
                        {
                          "text": " An assistance of  ₹4,000/- towards the cost of inputs to organize the demonstration and  ₹4,000/- to cover the land with Polythene sheet per hectare will be provided."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
