                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Fish Seed Stocking"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "100% assistance for fish seed and transportation cost"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "1 Year"
                        }
                      ],
                      "type": "table_cell"
                    }
                  ],
                  "type": "table_row"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Prawn Seed Stocking"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "100% assistance for prawn seed and transportation cost for Scheduled Caste lessees"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "1 Year"
                        }
                      ],
                      "type": "table_cell"
                    }
                  ],
                  "type": "table_row"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Boat & Net"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "50% assistance for Tin Boat & Net (₹15,000/- or ₹7,500/-, whichever is less); 50% assistance for F.R.P Boat & Net (₹30,000/- or ₹15,000/-, whichever is less)"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "6 Years"
                        }
                      ],
                      "type": "table_cell"
                    }
                  ],
                  "type": "table_row"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Fish Collection & Patrolling Boat"
