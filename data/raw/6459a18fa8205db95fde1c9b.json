        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant shall be an entrepreneur-aggregator /private individual, SHGs/FPOs/FCOs/ JLGs and Section 8 companies who have their registered offices in India."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "Entrepreneur/applicant shall have appropriate experience in breeding or rearing dairy animals"
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The entrepreneur/applicant will be responsible for arranging land of suitable size and location. At least having ownership/lease deed of 5 acres of land."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The entrepreneur/applicant will make its own arrangement for the procurement of feed and fodder as per the requirement of the farm"
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The entrepreneur will establish a breed multiplication farm of at least 200 milch cows/buffalo and use the latest breeding technology to continuously upgrade the stock."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ol_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "eligibilityDescription_md": "\n   1. The applicant shall be an entrepreneur-aggregator /private individual, SHGs/FPOs/FCOs/ JLGs and Section 8 companies who have their registered offices in India.\n   1. Entrepreneur/applicant shall have appropriate experience in breeding or rearing dairy animals\n   1. The entrepreneur/applicant will be responsible for arranging land of suitable size and location. At least having ownership/lease deed of 5 acres of land.\n   1. The entrepreneur/applicant will make its own arrangement for the procurement of feed and fodder as per the requirement of the farm\n   1. The entrepreneur will establish a breed multiplication farm of at least 200 milch cows/buffalo and use the latest breeding technology to continuously upgrade the stock.\n\n"
        },
