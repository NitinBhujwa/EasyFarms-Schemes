                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "Fish Collection Boat: ₹5,00,000/- unit cost, 75% assistance (₹3.75 lakh/- or 75% of purchase price); Four-wheel Transport Vehicle: ₹6,00,000/- unit cost, 75% subsidy (₹4.50 lakh/- or 75% of purchase price); Three-wheel Transport Vehicle: ₹2,00,000/- unit cost, 75% subsidy (₹1.50 lakh/- or 75% of purchase price)"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "Once in a lifetime"
                        }
                      ],
                      "type": "table_cell"
                    }
                  ],
                  "type": "table_row"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Scheme for fish sale equipments"
                        }
                      ],
                      "type": "table_cell"
                    },
