              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step 3:"
                  },
                  {
                    "text": " Select the \"Scheme name\" from the options provided."
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step 4:"
                  },
                  {
                    "text": " Enter your application number in the designated field."
                  }
                ],
                "type": "paragraph"
              },
              {
                "children": [
                  {
                    "bold": true,
                    "text": "Step 5: "
                  },
                  {
                    "text": "Click on \"Application Status\" again to view the status of your application."
                  }
                ],
                "type": "paragraph"
              },
