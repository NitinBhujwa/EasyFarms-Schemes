        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "This scheme is available to all categories of farmers."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "For individual farmers and farmer groups, the applicant must possess a minimum of 1.5 hectares of land at a single location."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "In Scheduled Tribe areas, a minimum of 0.5 hectares of land at one location is required."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "For community applications, a group comprising 10 or more farmers must collectively own a minimum of 5 hectares of land."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Additionally, the boundaries of the group's land must fall within the specified perimeter."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "\n1. This scheme is available to all categories of farmers.\n1. For individual farmers and farmer groups, the applicant must possess a minimum of 1.5 hectares of land at a single location.\n1. In Scheduled Tribe areas, a minimum of 0.5 hectares of land at one location is required.\n1. For community applications, a group comprising 10 or more farmers must collectively own a minimum of 5 hectares of land.\n1. Additionally, the boundaries of the group&#39;s land must fall within the specified perimeter.\n\n"
        },
