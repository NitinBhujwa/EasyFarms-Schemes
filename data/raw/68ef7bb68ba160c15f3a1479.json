        "schemeContent": {
          "benefitTypes": {
            "id": 2,
            "label": "In Kind",
            "value": "in-kind"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Exhibition: Demonstrations of major flowers such as rose, tuberose, aster, marigold, chrysanthemum, and gladiolus are conducted in farmers’ fields over an area of 0.04 hectares (400 square meters)."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Financial Assistance: A subsidy is provided at the rate of 75% or a maximum of ₹3,000/- per demonstration, whichever is less, based on ₹4,000/- per demonstration for seeds, plants, bulbs, or suckers."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "type": "paragraph"
            }
          ],
          "benefits_md": "\n  - Exhibition: Demonstrations of major flowers such as rose, tuberose, aster, marigold, chrysanthemum, and gladiolus are conducted in farmers’ fields over an area of 0.04 hectares (400 square meters).\n\n\n  - Financial Assistance: A subsidy is provided at the rate of 75% or a maximum of ₹3,000/- per demonstration, whichever is less, based on ₹4,000/- per demonstration for seeds, plants, bulbs, or suckers.\n\n<br>\n\n",
          "briefDescription": "The scheme aims to promote flower cultivation through demonstrations of major flowers like rose, tuberose, and marigold by providing financial assistance to farmers.",
          "detailedDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The scheme “Flower Development (Demonstration)” launched by the Horticulture and Food Processing Department, Government of Madhya Pradesh, aims to promote flower cultivation by conducting demonstrations of major flowers such as rose, tuberose, aster, marigold, chrysanthemum, and gladiolus in farmers' fields. Under this scheme, demonstrations are carried out in an area of 0.04 hectares (400 square meters) to encourage farmers to adopt flower farming practices."
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "align_justify"
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "type": "paragraph"
            }
          ],
          "detailedDescription_md": "The scheme “Flower Development (Demonstration)” launched by the Horticulture and Food Processing Department, Government of Madhya Pradesh, aims to promote flower cultivation by conducting demonstrations of major flowers such as rose, tuberose, aster, marigold, chrysanthemum, and gladiolus in farmers&amp;#39; fields. Under this scheme, demonstrations are carried out in an area of 0.04 hectares (400 square meters) to encourage farmers to adopt flower farming practices.\n<br>\n\n",
