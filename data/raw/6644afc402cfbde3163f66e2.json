        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant should be a farmer of milch cattle. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant should be a member of the \"Milk Producer Cooperation Committee\". "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The milch cattle of the farmer should be healthy and certified by a veterinary doctor at the time of insurance."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "eligibilityDescription_md": "\n1. The applicant should be a farmer of milch cattle. \n1. The applicant should be a member of the &quot;Milk Producer Cooperation Committee&quot;. \n1. The milch cattle of the farmer should be healthy and certified by a veterinary doctor at the time of insurance.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The maximum price per milch cattle has been fixed at ₹60,000/-. "
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The total amount of insurance at the rate of 3.5 percent will be ₹2,100/-."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The insurance company will insure milch cattle for 01 year. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The insurance company will fit the data ear tags in the milch cattle. "
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "NOTE 1:"
                },
                {
                  "text": " 75% amount of ₹1,575/- will be paid by the state government as a grant and the remaining 25% amount of ₹525/- will be paid by the cattle farmers to the insurance company. "
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "NOTE 2: "
                },
                {
                  "text": "The responsibility for the safety of milch cattle will be on the beneficiary."
                }
              ],
              "type": "block_quote"
            }
          ],
          "benefits_md": "\n- The maximum price per milch cattle has been fixed at ₹60,000/-. \n\n\n- The total amount of insurance at the rate of 3.5 percent will be ₹2,100/-.\n- The insurance company will insure milch cattle for 01 year. \n- The insurance company will fit the data ear tags in the milch cattle. \n\n> **NOTE 1:** 75% amount of ₹1,575/- will be paid by the state government as a grant and the remaining 25% amount of ₹525/- will be paid by the cattle farmers to the insurance company. \n\n> **NOTE 2:** The responsibility for the safety of milch cattle will be on the beneficiary.\n\n",
          "briefDescription": "The scheme 'Pashu Bima Yojna' was launched by the Directorate of Dairy Development, Government of Bihar. The scheme aims to provide insurance security to farmers against the financial loss caused by cattle death and to improve the rural economy. ",
          "detailedDescription": [
            {
              "children": [
                {
                  "text": "The scheme \"Pashu Bima Yojana\" by the Directorate of Dairy Development, Government of Bihar aims to provide financial security to livestock owners against losses due to serious diseases like Lumpy Skin Disease, HSBQ, and other causes of cattle death. Through this scheme, insurance coverage of up to ₹60,000 per dairy cattle is provided to livestock owners of all categories, with the government providing a 75% subsidy on the premium amount. The scheme is implemented by the District Dairy Development Officers across all districts of Bihar."
                }
              ],
              "type": "paragraph"
            }
          ],
          "detailedDescription_md": "The scheme &quot;Pashu Bima Yojana&quot; by the Directorate of Dairy Development, Government of Bihar aims to provide financial security to livestock owners against losses due to serious diseases like Lumpy Skin Disease, HSBQ, and other causes of cattle death. Through this scheme, insurance coverage of up to ₹60,000 per dairy cattle is provided to livestock owners of all categories, with the government providing a 75% subsidy on the premium amount. The scheme is implemented by the District Dairy Development Officers across all districts of Bihar.\n",
