                      "children": [
                        {
                          "text": "50% subsidy of total unit purchase cost (₹15,000/- or ₹7,500/-) Includes:                                                        Insulated box (₹1,000/-), Box (₹500/-), Renkadi (₹5,000/-), Weighing unit (₹1,000/-)"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "Once in a lifetime"
                        }
                      ],
                      "type": "table_cell"
                    }
                  ],
                  "type": "table_row"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Training of Scheduled Caste trainees"
