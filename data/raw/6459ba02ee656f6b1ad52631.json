        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The Entrepreneurs/ Eligible Entities shall be considered Eligible for availing benefit under the entrepreneurship programme if fulfils either of the following criteria:"
                    }
                  ],
                  "type": "paragraph"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Entrepreneurs/ Eligible Entitieseither have obtained training or have trained experts or have sufficient experience in the relevant field in managing and running the project or have technical experts with sufficient experience in the relevant field of managing and running the project."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The Entrepreneurs/ Eligible Entities have got the sanctioned loan for the project by the bank or financial institutions furnished bank guarantee from the scheduled bank along with an appraisal of the project for its validity by the bank where it is holding the account."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The Entrepreneurs/ Eligible Entities should own land or lease land where the project will be established."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The Entrepreneurs/ Eligible Entities have all the relevant documents for KYC."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ol_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "eligibilityDescription_md": "The Entrepreneurs/ Eligible Entities shall be considered Eligible for availing benefit under the entrepreneurship programme if fulfils either of the following criteria:\n\n   1. Entrepreneurs/ Eligible Entitieseither have obtained training or have trained experts or have sufficient experience in the relevant field in managing and running the project or have technical experts with sufficient experience in the relevant field of managing and running the project.\n   1. The Entrepreneurs/ Eligible Entities have got the sanctioned loan for the project by the bank or financial institutions furnished bank guarantee from the scheduled bank along with an appraisal of the project for its validity by the bank where it is holding the account.\n   1. The Entrepreneurs/ Eligible Entities should own land or lease land where the project will be established.\n   1. The Entrepreneurs/ Eligible Entities have all the relevant documents for KYC.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Affordable quality fodder."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Increased farmer’s income."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The mission now provides for a 50% direct capital subsidy to the beneficiaries under the feed and fodder entrepreneurship program and a 100% subsidy on fodder seed production to identified beneficiaries."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Assistance is available for procuring machineries like Bailers, Block making machines, TMR machines/equipment, and Forage Harvesters."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Cost which will be assisted for productions of various category of seeds are as under:"
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Breeder Seedup to Rs.250/kg"
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Foundation Seed up to Rs.150 /Kg"
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Certified Seed up to Rs. 100/Kg"
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            }
          ],
          "briefDescription": "It was launched by Union Government in 2014, and focused on supporting farmers in producing fodder from non-forest wasteland/grassland and cultivating coarse grains",
          "detailedDescription": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "Objectives "
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Establishing an effective seed production chain."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Capacity building of state functionaries and livestock owners in forage production, conservation and utilization."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Establishing convergence and synergy among ongoing Plan programmes and stakeholders for fodder resource development."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "Salient Feature"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Under this activity, the fodder seed chain i.e. breeder, foundation and certified quality fodder seed production will be incentivized."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "This component targeted towards the multiplication of seeds of high yielding fodder varieties which has been developed through research and innovations, significantly showing better performance, for which incentives will be provided."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ol_list"
            }
          ],
          "detailedDescription_md": "**Objectives** \n\n1. Establishing an effective seed production chain.\n1. Capacity building of state functionaries and livestock owners in forage production, conservation and utilization.\n1. Establishing convergence and synergy among ongoing Plan programmes and stakeholders for fodder resource development.\n\n<br>\n\n**Salient Feature**\n\n1. Under this activity, the fodder seed chain i.e. breeder, foundation and certified quality fodder seed production will be incentivized.\n1. This component targeted towards the multiplication of seeds of high yielding fodder varieties which has been developed through research and innovations, significantly showing better performance, for which incentives will be provided.\n\n",
          "references": [
            {
              "title": "Guidelines",
              "url": "https://ahvety.mizoram.gov.in/uploads/attachments/d2aa170eea17c223ac1a17f4af194019/feed-and-fodder-entrepreneurship-scheme-english.pdf"
            }
          ],
          "schemeImageUrl": ""
        },
