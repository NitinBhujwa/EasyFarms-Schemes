                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Fish Seed Rearing"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "₹90/- per 1000 spawn to fry (30% recovery); ₹260/- per 1000 fry to fingerlings (35% recovery); ₹460/- per 1000 spawn to fingerlings (12% recovery); Rearing time: 30, 60, 90 days"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "text": "1 Year"
                        }
                      ],
                      "type": "table_cell"
