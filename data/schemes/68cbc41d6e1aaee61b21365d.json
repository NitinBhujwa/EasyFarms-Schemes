  "deactivated_at": "2026-09-02T16:13:13.678776+00:00",
  "detailed_description": "The scheme “Dugdh Mulya Protsahan Yojana” was launched by the Department of Dairy Development, Government of Uttarakhand. The scheme aims to encourage milk production and ensure fair remuneration to cattle farmers by providing financial incentives based on the quality of milk supplied to cooperative societies.\n<br>\n\n",
  "eligibility": "\n1. The applicant must be a resident of Uttarakhand.\n1. The applicant must be a member of a milk-producing cooperative society supplying milk to the society.\n\n<br>\n\n",
  "exclusions": null,
