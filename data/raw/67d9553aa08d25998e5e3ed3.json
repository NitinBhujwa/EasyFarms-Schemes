        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant or their parent must have a registered land record before the date of the accident."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The death or disability must be caused by an accident."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The deceased/disabled person must be the registered farmer, their spouse, or any legal heir (son/daughter)."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The applicant must possess a valid driving license in case of death/injury (For vehicular accident)."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The beneficiary must be between 5 to 70 years of age (For accidental death or permanent disability)."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "Application should be made in the office of the concerned District Agriculture Officer within 150 days."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
