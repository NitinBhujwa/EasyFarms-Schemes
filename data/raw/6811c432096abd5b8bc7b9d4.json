            "label": "Cash",
            "value": "cash"
          },
          "benefits": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "For Intensive and Ultra-Intensive Farming of Mango, Guava, Pomegranate, Lemon, etc.:",
                  "underline": true
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Assistance of ₹30,000/- to ₹40,000/- per hectare."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Maximum up to 4 hectares per beneficiary."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "For New Plantation of Banana Tissue Culture Crop:",
                  "underline": true
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "40% of the incurred cost or maximum ₹50,000/- per hectare."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Maximum up to 4 hectares per beneficiary."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
