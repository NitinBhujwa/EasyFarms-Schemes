                {
                  "children": [
                    {
                      "text": "50% of the incurred cost or maximum ₹30,000/- per hectare."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "Paid in two installments."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
