                          "bold": true,
                          "text": "Sl. No."
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "Entitlement"
                        }
                      ],
                      "type": "table_cell"
                    },
                    {
                      "children": [
                        {
                          "bold": true,
                          "text": "Owantum of Assistance"
