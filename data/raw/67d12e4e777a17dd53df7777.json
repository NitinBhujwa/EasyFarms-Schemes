        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant should be a landholding farmer."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The applicant should belong to the Gujarat state."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant must purchase the Tractor from an "
                        },
                        {
                          "children": [
                            {
                              "text": "authorized dealer"
                            }
                          ],
                          "link": "https://ikhedut.gujarat.gov.in/Public/frm_Public_DealerDetails.aspx",
                          "type": "link"
                        },
                        {
                          "text": "."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                },
                {
                  "children": [
                    {
                      "bold": true,
                      "text": "Note:"
                    }
                  ],
                  "type": "block_quote"
                }
              ],
              "type": "align_justify"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "Beneficiary farmers can receive the benefit of one tractor component per land record (8 A)."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "Among the holders of a land record mentioned in 8-A, if there is more than one farmer, only one of these farmers will get benefits."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "If a farmer holds multiple land records or has a name in multiple land records, the benefits will be availed by the farmer on a single land record only."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The benefits are available once every 10 years per land record."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ul_list"
                }
              ],
              "type": "align_justify"
            }
          ],
          "eligibilityDescription_md": "\n  - The applicant should be a landholding farmer.\n  - The applicant should belong to the Gujarat state.\n\n\n  - The applicant must purchase the Tractor from an [authorized dealer](https://ikhedut.gujarat.gov.in/Public/frm_Public_DealerDetails.aspx).\n&gt; **Note:**\n\n\n  - Beneficiary farmers can receive the benefit of one tractor component per land record (8 A).\n  - Among the holders of a land record mentioned in 8-A, if there is more than one farmer, only one of these farmers will get benefits.\n  - If a farmer holds multiple land records or has a name in multiple land records, the benefits will be availed by the farmer on a single land record only.\n  - The benefits are available once every 10 years per land record.\n\n"
        },
