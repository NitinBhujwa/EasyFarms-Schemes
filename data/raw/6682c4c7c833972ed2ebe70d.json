        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant should be a farmer, entrepreneur, or member of SHG."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant belongs to General, SC, ST categories, SHG members, PWD, Women, and Transgender individuals."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant should purchase two Graded Murrah She Buffaloes, preferably in their 1st or 2nd lactation and yielding a minimum of 8 liters of milk per day."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "If the applicant is a PwD, their disability should be more than 40%."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "An individual per family will be eligible to avail assistance only once."
                    }
                  ],
                  "type": "list_item"
                }
              ],
