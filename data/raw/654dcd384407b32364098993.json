          "benefits": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "Subsidy Details"
                }
              ],
              "type": "paragraph"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The eligible subsidy for water harvesting structures and sprinkler units is 75% of the unit cost, capped at a maximum ceiling of ₹1,25,000 for all related activities combined."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "For below-ground water storage tanks, the subsidy is based on the lower value between dimension and unit cost applicable to the size of the holding."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "For above-ground water storage tanks, the subsidy is based on the lower value between the actual cost or the unit cost applicable to the below-ground water tank."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
