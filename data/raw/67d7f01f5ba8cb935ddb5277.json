        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "bold": true,
                  "text": "For Individual Farmers:"
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The applicant must be a farmer. "
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The applicant must belong to the Gujarat state."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            },
            {
              "children": [
                {
                  "bold": true,
                  "text": "For Joint Landholder Farmers:"
                }
              ],
              "type": "block_quote"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Only one landholder mentioned in the 8-A land record shall be eligible for the benefit."
                    }
                  ],
                  "type": "list_item"
                },
                {
                  "children": [
                    {
                      "text": "The selected landholder must have the consent of all other joint landholders."
                    }
                  ],
                  "type": "list_item"
                }
              ],
              "type": "ul_list"
            }
          ],
          "eligibilityDescription_md": "> **For Individual Farmers:**\n\n\n- The applicant must be a farmer. \n- The applicant must belong to the Gujarat state.\n\n> **For Joint Landholder Farmers:**\n\n\n- Only one landholder mentioned in the 8-A land record shall be eligible for the benefit.\n- The selected landholder must have the consent of all other joint landholders.\n\n"
        },
