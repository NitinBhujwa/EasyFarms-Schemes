          ],
          "eligibilityDescription_md": "\n   1. The applicant must be a farmer.\n   1. The applicant must be a resident of Gujarat.\n   1. Applicant must possess cultivable land ranging from 0.20 hectares to 4 hectares.\n\n"
        },
        "schemeContent": {
          "benefitTypes": {
            "id": 1,
