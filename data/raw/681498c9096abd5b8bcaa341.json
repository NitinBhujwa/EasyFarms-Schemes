        "eligibilityCriteria": {
          "eligibilityDescription": [
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "text": "The applicant must be a farmer."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": " The applicant must be a resident of Gujarat."
                        }
                      ],
                      "type": "list_item"
                    },
                    {
                      "children": [
                        {
                          "text": "The applicant must plan to construct a cemented water storage tank of at least 25.50 cubic meters capacity."
                        }
                      ],
                      "type": "list_item"
                    }
                  ],
                  "type": "ol_list"
                },
                {
                  "children": [
                    {
                      "bold": true,
                      "text": "Note:"
