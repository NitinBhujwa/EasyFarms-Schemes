                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": "Development Support Agency of Gujarat (D-SAG)"
                      }
                    ],
                    "link": "https://dsagsahay.gujarat.gov.in/",
                    "type": "link"
                  },
                  {
                    "text": ", "
                  },
                  {
                    "children": [
                      {
                        "text": "Tribal Development Department"
